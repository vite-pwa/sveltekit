{
  "name": "@vite-pwa/sveltekit",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Zero-config PWA for SvelteKit",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/sveltekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/sveltekit.git"
  },
  "bugs": "https://github.com/vite-pwa/sveltekit/issues",
  "keywords": [
    "sveltekit",
    "workbox",
    "pwa",
    "vite",
    "unplugin-pwa"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./legacy": "./dist/legacy.mjs",
    "./types": {
      "types": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint:sveltekit-ts": "pnpm run -C examples/sveltekit-ts lint",
    "lint:sveltekit-ts-legacy": "pnpm run -C examples/sveltekit-ts-legacy lint",
    "lint:sveltekit-ts-assets-generator-legacy": "pnpm run -C examples/sveltekit-ts-assets-generator-legacy lint",
    "lint": "eslint .",
    "lint:fix": "nr lint --fix",
    "lint:all": "nr lint && nr lint:sveltekit-ts && nr lint:sveltekit-ts-legacy && nr lint:sveltekit-ts-assets-generator-legacy",
    "lint:fix:all": "nr lint:fix && nr lint:fix:sveltekit-ts && nr lint:fix:sveltekit-ts-legacy && nr lint:fix:sveltekit-ts-assets-generator-legacy",
    "prepack": "pnpm build",
    "update:deps": "taze -I",
    "test:typecheck": "tsc --noEmit",
    "test:typecheck:sveltekit-ts": "pnpm run -C examples/sveltekit-ts check",
    "test:typecheck:sveltekit-ts-legacy": "pnpm run -C examples/sveltekit-ts-legacy check",
    "test:typecheck:sveltekit-ts-assets-generator-legacy": "pnpm run -C examples/sveltekit-ts-assets-generator-legacy check",
    "test:typecheck:all": "nr test:typecheck && nr test:typecheck:sveltekit-ts && nr test:typecheck:sveltekit-ts-legacy && nr test:typecheck:sveltekit-ts-assets-generator-legacy",
    "test:sveltekit-ts": "pnpm run -C examples/sveltekit-ts test",
    "test:sveltekit-ts-legacy": "pnpm run -C examples/sveltekit-ts-legacy test",
    "test:sveltekit-ts-assets-generator-legacy": "pnpm run -C examples/sveltekit-ts-assets-generator-legacy test",
    "test": "nr test:sveltekit-ts && nr test:sveltekit-ts-legacy && nr test:sveltekit-ts-assets-generator-legacy",
    "test:ci": "nr test:sveltekit-ts"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^1.3.1 || ^2.0.1 || ^3.0.0",
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@unplugin-pwa/core": "catalog:pwa",
    "@unplugin-pwa/inspector": "catalog:pwa",
    "@unplugin-pwa/vite": "catalog:pwa",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "@vite-pwa/workbox-swkit": "catalog:pwa",
    "@vite-pwa/workbox-window": "catalog:pwa",
    "verkit": "catalog:utils"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@arethetypeswrong/core": "catalog:utils",
    "@playwright/test": "catalog:utils",
    "@sveltejs/kit": "catalog:sveltekit3",
    "@types/node": "catalog:types",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "@vitejs/devtools": "catalog:utils",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "eslint-plugin-svelte": "catalog:eslint",
    "playwright-core": "catalog:utils",
    "publint": "catalog:utils",
    "taze": "catalog:utils",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:utils"
  }
}
