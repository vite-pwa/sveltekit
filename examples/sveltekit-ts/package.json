{
	"name": "sveltekit-ts",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev",
		"dev-generate": "GENERATE_SW=true vite dev",
		"dev-generate-suppress-w": "GENERATE_SW=true SUPPRESS_WARNING=true vite dev",
		"build-generate-sw": "GENERATE_SW=true vite build",
		"build-generate-sw-node": "NODE_ADAPTER=true GENERATE_SW=true vite build",
		"build-build-sw": "vite build",
		"build-build-sw-node": "NODE_ADAPTER=true vite build",
		"preview": "vite preview",
		"preview-node": "PORT=4173 node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test-generate-sw": "nr build-generate-sw && GENERATE_SW=true vitest run && GENERATE_SW=true playwright test",
		"test-generate-sw-node": "nr build-generate-sw-node && NODE_ADAPTER=true GENERATE_SW=true vitest run && NODE_ADAPTER=true GENERATE_SW=true playwright test",
		"test-build-sw": "nr build-build-sw && vitest run && playwright test",
		"test-build-sw-node": "nr build-build-sw-node && NODE_ADAPTER=true vitest run && NODE_ADAPTER=true playwright test",
		"test": "nr test-generate-sw && nr test-generate-sw-node && nr test-build-sw && nr test-build-sw-node"
	},
	"devDependencies": {
		"@eslint/js": "catalog:sveltekit3",
		"@playwright/test": "catalog:utils",
		"@sveltejs/adapter-node": "catalog:sveltekit3",
		"@sveltejs/adapter-static": "catalog:sveltekit3",
		"@sveltejs/kit": "catalog:sveltekit3",
		"@sveltejs/vite-plugin-svelte": "catalog:sveltekit3",
		"@types/node": "catalog:types",
		"@vite-pwa/sveltekit": "workspace:*",
		"@vitejs/devtools": "catalog:utils",
		"cookie": "catalog:sveltekit3",
		"eslint": "catalog:eslint",
		"eslint-plugin-svelte": "catalog:eslint",
		"globals": "catalog:sveltekit3",
		"svelte": "catalog:sveltekit3",
		"svelte-check": "catalog:sveltekit3",
		"typescript": "catalog:typescript",
		"typescript-eslint": "catalog:sveltekit3",
		"vite": "catalog:utils",
		"vitest": "catalog:test",
		"vite-plugin-inspect": "catalog:utils"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
